# Neon Postgres (Vercel Neon integration sets this)
DATABASE_URL=
# 32+ random characters for the session cookie
SESSION_SECRET=
# Private key (ed25519:...) of NEAR_SPONSOR_ACCOUNT. Never the contract admin key.
NEAR_SPONSOR_KEY=
NEXT_PUBLIC_PASS_CONTRACT=privue-app.testnet
NEAR_RPC_URL=https://rpc.testnet.fastnear.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Max sponsored passes per day across all guests
SPONSOR_DAILY_CAP=200
# Optional: NEAR Intents partner JWT (enables confidential quotes once your partner account has access)
ONECLICK_JWT=
# Optional: NEAR AI Cloud key for strategy notes (notes are off without it)
NEARAI_API_KEY=
# 32 random bytes, base64: seals private fills at rest (AES-256-GCM). Rotate by moving the old key to FILL_KEYS_OLD.
FILL_KEY=
FILL_KEYS_OLD=
# Operator account the contract trusts for sponsored passes, offers, guest transfers and record anchors
NEAR_SPONSOR_ACCOUNT=privue-operator.testnet
# Optional: second NEAR AI model that reviews every strategy note for leaks
NEARAI_REVIEW_MODEL=Qwen/Qwen3.6-35B-A3B-FP8
